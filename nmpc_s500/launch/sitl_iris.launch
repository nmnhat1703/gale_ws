<launch>
  <!-- ASSUMES: PX4 SITL + Gazebo + MAVROS already running, started
       by /home/nhat/PX4-Autopilot/launch/run_px4_sitl.sh. This
       launch only starts the NMPC node. -->

  <node name="nmpc_node" pkg="nmpc_s500" type="nmpc_node.py"
        output="screen" required="true">
    <param name="platform" value="sim_iris" />
    <param name="trajectory" value="circle" />
    <rosparam param="hover_position">[0.0, 0.0, 2.0]</rosparam>
    <rosparam param="circle_center">[0.0, 0.0, 2.0]</rosparam>
    <param name="circle_radius_m" value="3.0" />
    <param name="circle_period_sec" value="30.0" />
    <param name="circle_hover_sec" value="5.0" />
    <param name="circle_ramp_sec" value="8.0" />
    <param name="hover_yaw" value="0.0" />
    <param name="control_rate_hz" value="50" />
    <param name="enable_offboard_on_start" value="true" />
    <param name="shutdown_land_on_ctrl_c" value="true" />
    <rosparam param="shutdown_approach_position">[0.0, 0.0, 1.0]</rosparam>
    <param name="shutdown_yaw" value="0.0" />
    <param name="shutdown_approach_duration_sec" value="8.0" />
    <param name="shutdown_approach_timeout_sec" value="20.0" />
    <rosparam param="shutdown_land_position">[0.0, 0.0, 0.0]</rosparam>
    <param name="shutdown_land_timeout_sec" value="20.0" />
    <param name="diag_log_period_sec" value="0.2"/>  <!-- 5 Hz for SITL tuning; set to 1.0 for normal use -->
  </node>
</launch>
